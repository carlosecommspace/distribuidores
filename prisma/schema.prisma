generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  name         String?
  password     String?
  company      String?
  phone        String?
  slug         String?       @unique
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  role         String        @default("admin")
  clientId     String?       @unique
  clientLink   Client?       @relation("ClientPortalUser", fields: [clientId], references: [id], onDelete: SetNull)

  products      Product[]
  categories    Category[]
  clients       Client[]
  sales         Sale[]
  priceLists    PriceList[]
  requests      ProductRequest[]
  notifications Notification[]
  paymentMethods PaymentMethod[]
  waSession     WhatsAppSession?
  waContacts    WhatsAppContact[]
  mlConnection  MLConnection?
  settings      Settings?
}

model FileUpload {
  id        String   @id @default(cuid())
  userId    String   // tenant owner (dueño de la data, no necesariamente quién subió)
  uploaderId String  // usuario específico que subió (admin o portal)
  purpose   String   @default("payment_proof") // payment_proof, product_image, other
  filename  String
  mimeType  String
  size      Int
  data      Bytes
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([purpose])
}

model PaymentMethod {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  type          String   // zelle, binance, bank_transfer_bs, bank_transfer_usd, cash_usd, cash_bs, other
  label         String   // "Zelle Personal", "Cuenta Banesco Ahorro"
  accountName   String?  // Titular
  accountNumber String?  // Número de cuenta / email de Zelle / ID Binance
  bankName      String?  // Solo para transferencias
  documentId    String?  // C.I. o RIF del titular
  currency      String   @default("USD") // USD | VES
  instructions  String?  // Instrucciones opcionales para el cliente

  isActive      Boolean  @default(true)
  sortOrder     Int      @default(0)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId, isActive])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  type      String   // low_stock, ml_question, new_sale, etc.
  severity  String   @default("info") // info, warning, danger, success
  title     String
  body      String?
  link      String?

  // FK opcional al recurso que originó la notificación, para dedup y navegación
  resourceType String?
  resourceId   String?

  read      Boolean   @default(false)
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, read, createdAt])
  @@index([userId, resourceType, resourceId])
}

model Settings {
  id              String    @id @default(cuid())
  userId          String    @unique
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  exchangeRate    Float     @default(0)
  autoUpdateRate  Boolean   @default(true)
  lastRateUpdate  DateTime?

  eurExchangeRate    Float     @default(0)
  autoUpdateEurRate  Boolean   @default(true)
  lastEurRateUpdate  DateTime?

  primaryCurrency String    @default("USD")

  defaultMargin   Float     @default(0.15)

  waPhoneNumber   String?
  waApiToken      String?
  waWebhookSecret String?
  waRetentionDays Int       @default(90)     // retención de mensajes; 0 = modo privado (solo metadata)
  waAiEnabled     Boolean   @default(false)  // toggle IA global
  waAiPrompt      String?                    // prompt system del bot

  mlAutoAnswer    Boolean   @default(false)
  mlAutoSync      Boolean   @default(true)
  mlSyncInterval  Int       @default(60)

  notifLowStock   Boolean   @default(true)
  notifNewQuestion Boolean  @default(true)
  notifNewSale    Boolean   @default(false)

  updatedAt       DateTime  @updatedAt
}

model Product {
  id            String       @id @default(cuid())
  userId        String
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  sku           String
  name          String
  description   String?
  category      String?
  categoryId    String?
  categoryRel   Category?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  brand         String?
  unit          String       @default("unidad")
  images        String[]

  costUSD       Float        @default(0)
  priceUSD      Float
  priceBs       Float        @default(0)
  marginPercent Float        @default(0)

  stock         Int          @default(0)
  stockMin      Int          @default(5)
  stockMax      Int?

  mlItemId      String?
  mlStatus      String?
  mlCategoryId  String?
  mlListingType String       @default("gold_special")
  mlSyncEnabled Boolean      @default(false)
  mlLastSync    DateTime?

  isActive      Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  saleItems     SaleItem[]
  mlQuestions   MLQuestion[]
  priceListItems PriceListItem[]
  requestItems  ProductRequestItem[]

  @@unique([userId, sku])
  @@index([userId])
  @@index([categoryId])
}

model Category {
  id          String     @id @default(cuid())
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  name        String
  slug        String
  description String?
  color       String?
  icon        String?
  sortOrder   Int        @default(0)
  isActive    Boolean    @default(true)

  parentId    String?
  parent      Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children    Category[] @relation("CategoryTree")

  products    Product[]

  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@unique([userId, slug])
  @@index([userId])
  @@index([parentId])
}

model Client {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  name           String
  company        String?
  rif            String?   // RIF, cédula o documento fiscal del cliente
  contactPerson  String?   // Persona de contacto
  phone          String?
  email          String?
  address        String?   // Dirección física / de despacho
  billingAddress String?   // Dirección de facturación (si difiere)
  city           String?
  type           String    @default("retail")
  notes          String?

  totalPurchases Float     @default(0)
  lastPurchase   DateTime?

  priceListId    String?
  priceList      PriceList? @relation(fields: [priceListId], references: [id], onDelete: SetNull)

  portalUser     User?     @relation("ClientPortalUser")
  requests       ProductRequest[]
  waContacts     WhatsAppContact[]

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  sales          Sale[]

  @@index([userId])
}

model PriceList {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  name      String
  notes     String?
  isActive  Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items     PriceListItem[]
  clients   Client[]

  @@unique([userId, name])
  @@index([userId])
}

model PriceListItem {
  id          String    @id @default(cuid())
  priceListId String
  priceList   PriceList @relation(fields: [priceListId], references: [id], onDelete: Cascade)
  productId   String
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  priceUSD    Float

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([priceListId, productId])
  @@index([productId])
}

model ProductRequest {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  // Código legible tipo DIS-001. Único por tenant.
  code        String?

  // status: pending | partially_paid | paid | released | cancelled
  status      String   @default("pending")
  notes       String?
  totalUSD    Float    @default(0)
  discountUSD Float    @default(0)  // Descuento aplicado por el admin
  discountReason String?
  paidUSD     Float    @default(0)

  fulfilledAt DateTime?
  releasedAt  DateTime?

  saleId      String?  @unique
  sale        Sale?    @relation("RequestRelease", fields: [saleId], references: [id], onDelete: SetNull)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items       ProductRequestItem[]
  payments    Payment[]

  @@unique([userId, code])
  @@index([userId, status])
  @@index([clientId])
  @@index([createdAt])
}

model Payment {
  id           String   @id @default(cuid())
  requestId    String
  request      ProductRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  amountUSD    Float
  amountBs     Float    @default(0)
  exchangeRate Float    @default(0)

  // method: cash_usd | cash_bs | zelle | binance | transfer_bs | transfer_usd | other
  method       String
  // origin: portal | admin (quién lo registró)
  origin       String   @default("portal")
  reference    String?  // últimos 4 dígitos, número de transacción, etc.
  proofUrl     String?  // URL al comprobante (screenshot, PDF, etc.)
  note         String?

  // status: submitted | verified | rejected
  status       String   @default("submitted")
  verifiedAt   DateTime?
  verifiedBy   String?
  rejectedReason String?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([requestId, status])
  @@index([createdAt])
}

model ProductRequestItem {
  id          String         @id @default(cuid())
  requestId   String
  request     ProductRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  productId   String
  product     Product        @relation(fields: [productId], references: [id])

  quantity    Int
  priceUSD    Float
  subtotalUSD Float
}

model Sale {
  id            String     @id @default(cuid())
  userId        String
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientId      String?
  client        Client?    @relation(fields: [clientId], references: [id])

  channel       String
  mlOrderId     String?

  subtotalUSD   Float
  totalUSD      Float
  totalBs       Float      @default(0)
  exchangeRate  Float

  paymentMethod String     @default("cash_usd")
  paymentStatus String     @default("paid")

  notes         String?
  status        String     @default("completed")

  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  items         SaleItem[]
  releasedFrom  ProductRequest? @relation("RequestRelease")

  @@index([userId])
  @@index([createdAt])
}

model SaleItem {
  id          String  @id @default(cuid())
  saleId      String
  sale        Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId   String
  product     Product @relation(fields: [productId], references: [id])

  quantity    Int
  priceUSD    Float
  subtotalUSD Float
}

model MLConnection {
  id           String       @id @default(cuid())
  userId       String       @unique
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  mlUserId     String
  accessToken  String
  refreshToken String
  tokenExpiry  DateTime
  siteId       String       @default("MLV")

  isActive     Boolean      @default(true)
  connectedAt  DateTime     @default(now())
  lastSync     DateTime?

  questions    MLQuestion[]
}

model MLQuestion {
  id            String       @id @default(cuid())
  mlQuestionId  String       @unique
  connectionId  String
  connection    MLConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  productId     String?
  product       Product?     @relation(fields: [productId], references: [id])

  mlItemId      String
  questionText  String
  buyerNickname String?
  status        String       @default("unanswered")

  answerText    String?
  answeredAt    DateTime?
  answeredBy    String?
  aiSuggestion  String?

  createdAt     DateTime     @default(now())

  @@index([connectionId, status])
}

model ExchangeRateLog {
  id        String   @id @default(cuid())
  rate      Float
  source    String   @default("bcv")
  currency  String   @default("USD")
  createdAt DateTime @default(now())

  @@index([currency, createdAt])
}

model QuickReply {
  id        String   @id @default(cuid())
  userId    String
  trigger   String
  reply     String
  createdAt DateTime @default(now())

  @@index([userId])
}

// -----------------------------------------------------------------------------
// WhatsApp — sesión Baileys por tenant, contactos, mensajes.
// El authState va cifrado (AES-GCM) con la clave WA_ENCRYPTION_KEY del server.
// -----------------------------------------------------------------------------

model WhatsAppSession {
  id            String    @id @default(cuid())
  userId        String    @unique
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  // status: disconnected | connecting | qr_pending | connected | banned
  status        String    @default("disconnected")
  provider      String    @default("baileys") // baileys | cloud_api

  phoneNumber   String?   // se llena al conectarse
  displayName   String?
  qrCode        String?   // último QR string (para render en front); expira rápido
  qrGeneratedAt DateTime?

  // authState cifrado (AES-256-GCM). Sin cifrar en dev si WA_ENCRYPTION_KEY vacío.
  authState     Bytes?
  authVersion   Int       @default(1)

  connectedAt   DateTime?
  disconnectedAt DateTime?
  lastActivity  DateTime?
  lastError     String?

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([status])
}

model WhatsAppContact {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  phoneNumber   String    // E.164 sin +, ej "584121234567" (o el LID si es un contacto anonimo)
  jid           String?   // JID completo de WhatsApp, ej "584121234567@s.whatsapp.net" o "12345@lid"
  name          String?   // display name enviado por WA
  clientId      String?
  client        Client?   @relation(fields: [clientId], references: [id], onDelete: SetNull)

  unreadCount   Int       @default(0)
  lastMessageAt DateTime?
  lastMessagePreview String?
  lastDirection String?   // in | out
  aiEnabled     Boolean   @default(false)
  archived      Boolean   @default(false)

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  messages      WhatsAppMessage[]

  @@unique([userId, phoneNumber])
  @@index([userId, lastMessageAt])
  @@index([clientId])
}

model WhatsAppMessage {
  id            String   @id @default(cuid())
  userId        String
  contactId     String
  contact       WhatsAppContact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  externalId    String?  // ID de mensaje en WA (unique key para dedup)
  direction     String   // in | out
  content       String   // texto plano; puede ser vacío si es solo media
  mediaUrl      String?  // URL en /api/uploads/[id] si es media descargada
  mediaType     String?  // image | audio | video | document | sticker
  status        String   @default("sent") // queued | sent | delivered | read | failed
  respondedByBot Boolean @default(false)
  errorMessage  String?

  createdAt     DateTime @default(now())

  @@unique([contactId, externalId])
  @@index([contactId, createdAt])
  @@index([userId, createdAt])
}
