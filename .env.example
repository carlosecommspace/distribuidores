DATABASE_URL="postgresql://user:password@localhost:5432/distribos"
# NextAuth v5 (genera con: openssl rand -base64 32)
AUTH_SECRET="change-me-to-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"

ML_CLIENT_ID=""
ML_CLIENT_SECRET=""
ML_REDIRECT_URI="http://localhost:3000/api/ml/auth/callback"

ANTHROPIC_API_KEY=""

# URL pública del app (para links que envía el bot por WhatsApp).
# Si no se define, se usa NEXTAUTH_URL. En Railway apunta al dominio público del servicio web.
APP_PUBLIC_URL=""

SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""

# --- WhatsApp (Baileys) ---
# URL del worker (proceso separado de Next). En Railway crea un segundo servicio.
# Ejemplo local: http://localhost:3001
WA_WORKER_URL=""
# Token compartido entre web y worker para autenticar requests.
WA_WORKER_SECRET=""
# Puerto del worker (default 3001)
WA_WORKER_PORT="3001"
# Clave hex de 32 bytes (openssl rand -hex 32) para cifrar el authState en Postgres.
WA_ENCRYPTION_KEY=""
